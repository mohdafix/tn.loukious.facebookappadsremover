<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tvVideoId"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="VideoId: 1073963148539453"
            android:textColor="#4C9AFF"
            android:textStyle="bold"
            android:gravity="center_vertical"/>
        <Button
            android:id="@+id/btnGetDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Get desc"
            android:textSize="12sp"
            android:textColor="#D5D8DD"
            android:backgroundTint="#1F1F1F"
            android:minHeight="0dp"
            android:padding="8dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="100dp"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:background="#1F1F1F" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginLeft="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1">
                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="Save video"
                    android:textSize="12sp"
                    android:textColor="#D5D8DD"
                    android:backgroundTint="#1F1F1F"
                    android:layout_marginRight="4dp"/>
                <Button
                    android:id="@+id/btnRepost"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="Repost"
                    android:textSize="12sp"
                    android:textColor="#D5D8DD"
                    android:backgroundTint="#1F1F1F"
                    android:layout_marginLeft="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_weight="1"
                android:layout_marginTop="8dp">
                <Button
                    android:id="@+id/btnDownloadSd"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="Download video SD"
                    android:textSize="11sp"
                    android:textColor="#D5D8DD"
                    android:backgroundTint="#1F1F1F"
                    android:layout_marginRight="4dp"/>
                <Button
                    android:id="@+id/btnDownloadHd"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="Download video HD"
                    android:textSize="11sp"
                    android:textColor="#EF5350"
                    android:backgroundTint="#1F1F1F"
                    android:layout_marginLeft="4dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnSeeMore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="See more"
                android:textSize="12sp"
                android:textColor="#D5D8DD"
                android:backgroundTint="#1F1F1F"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22262B"
        android:layout_marginTop="16dp"/>
</LinearLayout>